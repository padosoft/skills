# Work output
shots/
out/
dist/
*.png
!assets/*.png
payload.json
scripts/payload.json
*.eml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node (only for the optional screenshot tooling)
node_modules/
package-lock.json

# The harvest configuration names the repositories you run, and the ledger names their
# files. Both are metadata about your work, and this repository is public.
# .harvest-sources.example.json is the committed template.
.harvest-sources.json
.harvest-ledger.json
_harvest/

# The provenance denylist names the customers, brands and people it protects:
# committing it publishes the list. Keep it here, or outside the repo via
# PROVENANCE_DENYLIST=<path>. In CI it comes from a secret.
.provenance-denylist

# Secrets: never commit Mailtrap/MailUp tokens
.env
.env.*
!.env.example
*.token
secrets/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
