    {
      "key": "PROMPT",
      "title": "Prompting best practices",
      "url": "https://platform.claude.com/docs/en/build-with-claude/prompt-engineering/claude-prompting-best-practices.md",
      "track_headings": false,
      "rules": [
        "G-GEN-02",
        "G-GEN-03",
        "G-GEN-04",
        "G-GEN-06",
        "G-GEN-09"
      ],
      "anchors": [
        {
          "text": "dial back any aggressive language",
          "rules": [
            "G-GEN-02"
          ]
        },
        {
          "text": "Providing context or motivation behind your instructions",
          "rules": [
            "G-GEN-03"
          ]
        },
        {
          "text": "Tell Claude what to do instead of what not to do",
          "rules": [
            "G-GEN-04"
          ]
        },
        {
          "text": "Prefer general instructions over prescriptive steps",
          "rules": [
            "G-GEN-06"
          ]
        },
        {
          "text": "remove these instructions rather than rewriting them",
          "rules": [
            "G-GEN-07"
          ]
        },
        {
          "text": "If in doubt, use [tool]",
          "rules": [
            "G-GEN-02"
          ]
        },
        {
          "text": "Use subagents when tasks can run in parallel",
          "rules": [
            "G-GEN-09"
          ]
        }
      ]
    },
    {
      "key": "OPUS55",
      "title": "Prompting Claude Opus 5.5",
