        "G-GEN-07",
        "G-GEN-08",
        "G-GEN-09",
        "G-GEN-10"
      ],
      "anchors": [
        {
          "text": "If your prompt contains explicit verification instructions",
          "rules": [
            "G-GEN-07"
          ]
