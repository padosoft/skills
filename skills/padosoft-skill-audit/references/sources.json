    },
    {
      "key": "SONNET55",
      "title": "Prompting Claude Sonnet 5.5",
      "url": "https://platform.claude.com/docs/en/build-with-claude/prompt-engineering/prompting-claude-sonnet-5-5.md",
      "track_headings": false,
      "rules": [
        "G-GEN-07",
        "G-GEN-08",
        "G-MODEL-05"
      ],
      "anchors": [
        {
          "text": "Keep working until everything the user asked for is done",
          "rules": [
            "G-MODEL-05"
          ]
        },
        {
          "text": "When the work the user asked for is done and checked, stop and report",
          "rules": [
            "G-GEN-08",
            "G-MODEL-05"
          ]
        },
        {
          "text": "Don't add features, tests, files, docs or refactors that weren't asked for",
          "rules": [
            "G-GEN-08"
          ]
        },
        {
          "text": "run a real check that exercises the change before reporting it done",
          "rules": [
            "G-GEN-07",
            "G-MODEL-05"
          ]
        }
      ]
    },
    {
      "key": "SONNET5",
