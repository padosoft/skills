      "key": "BP",
      "title": "Skill authoring best practices",
      "url": "https://platform.claude.com/docs/en/agents-and-tools/agent-skills/best-practices.md",
      "track_headings": true,
      "rules": [
        "G-BODY-01",
        "G-FREE-01",
        "G-DESC-02",
        "G-STRUCT-01",
        "G-STRUCT-02",
        "G-STRUCT-03",
        "G-FLOW-02",
        "G-FLOW-04",
        "G-EVAL-01"
      ],
      "anchors": [
        {
          "text": "Claude is already very smart",
          "rules": [
            "G-BODY-01"
          ]
        },
        {
          "text": "Match the level of specificity to the task's fragility and variability",
          "rules": [
            "G-FREE-01"
          ]
        },
        {
          "text": "Test your Skill with all the models you plan to use it with",
          "rules": [
            "G-EVAL-06",
            "G-MODEL-06"
          ]
        },
        {
          "text": "aim for instructions that work well with all of them",
          "rules": [
            "G-MODEL-01",
            "G-MODEL-02"
          ]
        },
        {
          "text": "Cannot contain reserved words",
          "rules": [
            "G-FM-02"
          ]
        },
        {
          "text": "Maximum 1,024 characters",
          "rules": [
            "G-DESC-01"
          ]
        },
        {
          "text": "Always write in third person",
          "rules": [
            "G-DESC-02"
          ]
        },
        {
          "text": "Keep SKILL.md body under 500 lines for optimal performance",
          "rules": [
            "G-STRUCT-01"
          ]
        },
        {
          "text": "Keep references one level deep from SKILL.md",
          "rules": [
            "G-STRUCT-02"
          ]
        },
        {
          "text": "For reference files longer than 100 lines, include a table of contents at the top",
          "rules": [
            "G-STRUCT-03"
          ]
        },
        {
          "text": "provide a checklist that Claude can copy into its response",
          "rules": [
            "G-FLOW-02"
          ]
        },
        {
          "text": "If verification fails, return to Step 2",
          "rules": [
            "G-FLOW-03"
          ]
        },
        {
          "text": "Run validator → fix errors → repeat",
          "rules": [
            "G-FLOW-04"
          ]
        },
        {
          "text": "Don't include information that will become outdated",
          "rules": [
            "G-BODY-10"
          ]
        },
        {
          "text": "Create evaluations BEFORE writing extensive documentation",
          "rules": [
            "G-EVAL-01"
          ]
        },
        {
          "text": "Handle error conditions rather than deferring to Claude",
          "rules": [
            "G-SCRIPT-01"
          ]
        },
        {
          "text": "Make clear in your instructions whether Claude should",
          "rules": [
            "G-STRUCT-07"
          ]
        },
        {
          "text": "Always use forward slashes in file paths",
          "rules": [
            "G-STRUCT-06"
          ]
        },
        {
          "text": "always use fully qualified tool names",
          "rules": [
            "G-PORT-04"
          ]
        }
      ],
