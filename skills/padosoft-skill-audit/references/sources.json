    {
      "key": "CC",
      "title": "Claude Code: skills",
      "url": "https://code.claude.com/docs/en/skills.md",
      "track_headings": true,
      "rules": [
        "G-FM-03",
        "G-FM-04",
        "G-DESC-01",
        "G-DESC-08",
        "G-BODY-02",
        "G-BODY-03",
        "G-FREE-02",
        "G-SAFE-01",
        "G-SAFE-02",
        "G-SAFE-03",
        "G-MODEL-03"
      ],
      "anchors": [
        {
          "text": "truncated at 1,536 characters",
          "rules": [
            "G-DESC-01"
          ]
        },
        {
          "text": "The budget scales at 1% of the model's context window",
          "rules": [
            "G-DESC-08"
          ]
        },
        {
          "text": "keeping the first 5,000 tokens of each",
          "rules": [
            "G-BODY-02"
          ]
        },
        {
          "text": "combined budget of 25,000 tokens",
          "rules": [
            "G-BODY-02"
          ]
        },
        {
          "text": "put the most important instructions near the top of SKILL.md",
          "rules": [
            "G-BODY-02"
          ]
        },
        {
          "text": "does not re-read the skill file on later turns",
          "rules": [
            "G-BODY-03"
          ]
        },
        {
          "text": "move the rule into a",
          "rules": [
            "G-FREE-02"
          ]
        },
        {
          "text": "Set to true to prevent Claude from automatically loading this skill",
          "rules": [
            "G-SAFE-01",
            "G-FREE-03"
          ]
        },
        {
          "text": "Tools Claude can use without asking permission during the turn that invokes this skill",
          "rules": [
            "G-SAFE-02"
          ]
        },
        {
          "text": "only makes sense for skills with explicit instructions",
          "rules": [
            "G-SAFE-03"
          ]
        },
        {
          "text": "Keep SKILL.md under 500 lines",
          "rules": [
            "G-STRUCT-01"
          ]
        },
        {
          "text": "CLAUDE_EFFORT",
          "rules": [
            "G-MODEL-03"
          ]
        },
        {
          "text": "CLAUDE_SKILL_DIR",
          "rules": [
            "G-STRUCT-06",
            "G-PORT-05"
          ]
        },
        {
          "text": "ultrathink",
          "rules": [
            "G-GEN-06"
          ]
        },
        {
          "text": "Run /skill-doctor",
          "rules": [
            "G-LIB-04"
          ]
        }
