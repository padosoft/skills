        {
          "text": "Prompts, skills, and tool descriptions that ask Claude Opus 5 to write out its thinking",
          "rules": [
            "G-GEN-05"
          ]
        },
        {
          "text": "Deliver what was asked, at the scope intended",
          "rules": [
            "G-GEN-08"
          ]
        },
        {
          "text": "delegates to subagents more readily than prior models",
          "rules": [
            "G-GEN-09"
          ]
        },
        {
          "text": "Match the length of written documents to what the task needs",
          "rules": [
            "G-GEN-10"
          ]
        }
